# Vazon: local development environment (Docker Compose).
# Copy to .env and adjust if needed:   cp .env.example .env
# .env is git-ignored. Never commit real secrets. These values are for local development only.

# PostgreSQL (container)
POSTGRES_USER=vazon
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=vazon

# Host ports, chosen to avoid the usual 5432 / 3000 / 5173 used by other local projects
POSTGRES_PORT=5440
BACKEND_PORT=3100
FRONTEND_PORT=5180

# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5180

# JWT signing secret for the API. Required. Local placeholder only:
# use a long random value anywhere else (for example: openssl rand -hex 32).
JWT_SECRET=change-me-local-only
# Access token lifetime ("ms" format: 15m, 1h, 7d)
JWT_EXPIRES_IN=1h

# URL the browser uses to reach the API
VITE_API_URL=http://localhost:3100/api/v1
