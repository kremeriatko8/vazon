// Vazon database schema.
//
// Conventions
// - Primary keys are UUIDs generated by the application.
// - Model and field names are camelCase in TypeScript and snake_case in PostgreSQL (@map / @@map).
// - Timestamps are stored as `timestamptz` in UTC and shown to users in Europe/Kyiv.
// - CareTask.scheduledDate is a calendar date (no time): the day the task is due in Europe/Kyiv.
//
// This is the initial schema. The care-scheduling rules themselves are NOT implemented yet.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum LightCondition {
  LOW
  MEDIUM
  BRIGHT_INDIRECT
  DIRECT
}

enum PotSize {
  SMALL
  MEDIUM
  LARGE
}

/// How the owner says the plant is doing. DEAD plants get no care tasks.
enum PlantStatus {
  HEALTHY
  NEEDS_ATTENTION
  DEAD
}

/// How much water a species needs compared with a typical houseplant.
/// LOW: cacti and succulents; HIGH: ferns, calatheas and other moisture lovers.
enum WaterNeed {
  LOW
  MEDIUM
  HIGH
}

enum RadiatorDistance {
  NEAR // under 1 metre
  MEDIUM // 1–2 metres
  FAR // more than 2 metres
  NONE // no radiator in the room
}

enum CareTaskType {
  WATER
  FEED
  REPOT
}

enum CareTaskStatus {
  PENDING
  DONE
  SKIPPED
}

/// Interface language. Lower case to match the frontend's i18n codes.
enum Language {
  uk
  en
}

enum FeedbackCategory {
  BUG
  IDEA
  OTHER
}

enum CareActionType {
  DONE // owner marked a scheduled task as done (generic)
  SOIL_WET // owner checked the soil and it did not need water yet
  WATERED
  FED
  REPOTTED
}

// ---------- Models ----------

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(254)
  /// scrypt hash, see src/auth/password.ts. Plain-text passwords are never stored.
  /// Null for accounts created through Google sign-in.
  passwordHash String?  @map("password_hash")
  /// Google account id ("sub" claim), set once the user signs in with Google.
  googleId     String?  @unique @map("google_id") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  plants   Plant[]
  feedback Feedback[]
  settings UserSettings?

  @@map("users")
}

model Plant {
  id               String           @id @default(uuid()) @db.Uuid
  ownerId          String           @map("owner_id") @db.Uuid
  name             String           @db.VarChar(100)
  /// Free text shown to the owner (e.g. "Monstera deliciosa"). Kept even when speciesId is set.
  species          String           @db.VarChar(150)
  /// Optional link to the species catalog. Cleared if the catalog entry is removed.
  speciesId        String?          @map("species_id") @db.Uuid
  /// File name of the owner's photo in the photo storage (random, unguessable), or null.
  photoKey         String?          @map("photo_key") @db.VarChar(100)
  lightCondition   LightCondition   @map("light_condition")
  potSize          PotSize          @map("pot_size")
  radiatorDistance RadiatorDistance @default(NONE) @map("radiator_distance")
  status           PlantStatus      @default(HEALTHY)
  /// When the status last changed, or null if it never changed.
  statusChangedAt  DateTime?        @map("status_changed_at") @db.Timestamptz(3)
  /// Where the plant stands, in the owner's words, e.g. "Living room window".
  location         String?          @db.VarChar(100)
  /// Free notes from the owner.
  notes            String?          @db.VarChar(1000)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner       User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  speciesInfo Species?      @relation(fields: [speciesId], references: [id], onDelete: SetNull)
  careTasks   CareTask[]
  careHistory CareHistory[]

  @@index([ownerId])
  @@index([speciesId])
  @@map("plants")
}

/// Reference catalog of houseplant species. Filled by a data migration, not by users.
/// Source and verification status: see the migration that inserts the rows.
model Species {
  id               String         @id @default(uuid()) @db.Uuid
  /// Botanical name as given by the source, e.g. "Monstera Deliciosa". May include a cultivar.
  scientificName   String         @unique @map("scientific_name") @db.VarChar(150)
  /// Common name. One name for both interface languages.
  commonName       String         @map("common_name") @db.VarChar(150)
  recommendedLight LightCondition @map("recommended_light")
  /// Water need group used by the schedule engine. Data status: TO VERIFY.
  waterNeed        WaterNeed      @default(MEDIUM) @map("water_need")
  /// Genus watering factor: multiplies the base WATER interval instead of the
  /// water-need group factor. Null means "use the group". Data status: TO VERIFY.
  wateringFactor   Float?         @map("watering_factor")
  photoUrl         String?        @map("photo_url") @db.VarChar(500)
  /// Author and licence of the photo, shown next to it (required by CC licences).
  photoAttribution String?        @map("photo_attribution") @db.VarChar(300)
  /// Page of the photo on Wikimedia Commons (author, licence, original file).
  photoSourceUrl   String?        @map("photo_source_url") @db.VarChar(500)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  plants Plant[]

  @@map("species")
}

model CareTask {
  id            String         @id @default(uuid()) @db.Uuid
  plantId       String         @map("plant_id") @db.Uuid
  taskType      CareTaskType   @map("task_type")
  /// Due day in Europe/Kyiv, stored as a DATE.
  scheduledDate DateTime       @map("scheduled_date") @db.Date
  status        CareTaskStatus @default(PENDING)
  completedAt   DateTime?      @map("completed_at") @db.Timestamptz(3)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  plant        Plant         @relation(fields: [plantId], references: [id], onDelete: Cascade)
  historyItems CareHistory[]

  @@index([plantId, scheduledDate])
  @@index([status, scheduledDate])
  @@map("care_tasks")
}

model CareHistory {
  id         String         @id @default(uuid()) @db.Uuid
  plantId    String         @map("plant_id") @db.Uuid
  /// Optional link to the task this action completed or postponed.
  careTaskId String?        @map("care_task_id") @db.Uuid
  actionType CareActionType @map("action_type")
  actionDate DateTime       @default(now()) @map("action_date") @db.Timestamptz(3)
  notes      String?        @db.VarChar(1000)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  plant    Plant     @relation(fields: [plantId], references: [id], onDelete: Cascade)
  careTask CareTask? @relation(fields: [careTaskId], references: [id], onDelete: SetNull)

  @@index([plantId, actionDate])
  @@index([careTaskId])
  @@map("care_history")
}

/// Feedback about the website from users, read by the team. Anonymous when userId is null.
model Feedback {
  id        String           @id @default(uuid()) @db.Uuid
  /// Set when the sender was signed in. Kept as null if the user is deleted.
  userId    String?          @map("user_id") @db.Uuid
  category  FeedbackCategory
  message   String           @db.VarChar(2000)
  /// Page the feedback was sent from, e.g. "/plants/new".
  page      String?          @db.VarChar(200)
  /// Browser User-Agent, to reproduce bugs.
  userAgent String?          @map("user_agent") @db.VarChar(300)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
  @@map("feedback")
}

/// Per-user preferences. A missing row means "all defaults".
model UserSettings {
  userId           String   @id @map("user_id") @db.Uuid
  /// How the app greets the user ("Good morning, Sofiia"). Null: use the part of the email before "@".
  displayName      String?  @map("display_name") @db.VarChar(50)
  language         Language @default(en)
  remindersEnabled Boolean  @default(true) @map("reminders_enabled")
  /// Local time in Europe/Kyiv, "HH:MM" (24-hour), when the daily reminder is sent.
  reminderTime     String   @default("09:00") @map("reminder_time") @db.VarChar(5)
  /// Also remind the day before a task is due.
  dayBeforeAlert   Boolean  @default(false) @map("day_before_alert")
  /// One daily email with all of the day's tasks.
  emailDigest      Boolean  @default(true) @map("email_digest")
  /// Europe/Kyiv day ("YYYY-MM-DD") the last reminder email was sent, so at most one goes out per day.
  lastReminderSentOn String? @map("last_reminder_sent_on") @db.VarChar(10)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}
