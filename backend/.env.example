# Backend environment for running the API WITHOUT Docker (npm run start:dev).
# Copy to backend/.env:   cp backend/.env.example backend/.env
# Validated at startup by src/config/env.validation.ts.

NODE_ENV=development
PORT=3100

# Points at the Postgres container published on host port 5440 (see root .env.example).
DATABASE_URL=postgresql://vazon:change-me-local-only@localhost:5440/vazon?schema=public

# Comma-separated list of browser origins allowed by CORS
CORS_ORIGINS=http://localhost:5180

# JWT signing secret. Required: the API refuses to start without it.
# Local placeholder only; use a long random value outside local development.
JWT_SECRET=change-me-local-only
# Access token lifetime ("ms" format, for example 15m, 1h, 7d). Defaults to 1h.
JWT_EXPIRES_IN=1h

# Public origin of the API; plant photo URLs are built from it.
PUBLIC_API_URL=http://localhost:3100

# Google sign-in (optional). OAuth client of type "Web application" in Google
# Cloud (Google Auth Platform > Clients). Its authorized redirect URI must equal
# GOOGLE_CALLBACK_URL. Never commit the secret.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3100/api/v1/auth/google/callback
# Where the browser returns after Google sign-in (the frontend origin)
FRONTEND_URL=http://localhost:5180

# Folder for uploaded plant photos. Relative paths start at the backend folder.
# Not committed to git (see .gitignore). Defaults to "uploads".
UPLOADS_DIR=uploads

# Reminder emails (optional, free Brevo plan). Without both, emails are only logged.
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Vazon
# Secret for POST /api/v1/internal/reminders/run. Empty means the endpoint is off.
CRON_SECRET=
